# Agent runner (app/agent). Devnet and testnet values are written by `python3 -I scripts/demo-env.py`.
RPC_URL=https://free.rpc.fastnear.com
VAULT_ID=vault.<owner>.near
AGENT_ID=agent.<owner>.near
# Comma-separated function-call keys (receiver VAULT_ID, method request_payment). Never a full-access key.
AGENT_KEYS=ed25519:...,ed25519:...
MERCHANT_URL=http://localhost:8787
MERCHANT_ID=shop.<owner>.near
ATTACKER_ID=attacker.<owner>.near
# "nearai" (NEAR AI Cloud) or "scripted" (no model; obeys the merchant's text, for offline demos).
PLANNER=nearai
NEARAI_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=
# Comma-separated origins of the owner app.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=8788

# Demo merchant (demo/merchant)
# MERCHANT_ID=shop.<owner>.near
# INTENTS_ID=intents.near
# VAULT_ID=vault.<owner>.near
# TOKEN_ID=nep141:wrap.near
# DB_PATH=merchant.sqlite
# INJECT_RECIPIENT=attacker.<owner>.near   # demo T1 only
