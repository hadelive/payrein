# Owner app. Devnet and testnet values are written to .env.local by `python3 -I scripts/demo-env.py`.
# VITE_NETWORK is required: mainnet, testnet or devnet. The RPC and Intents defaults follow it
# (mainnet: free.rpc.fastnear.com and intents.near; testnet: test.rpc.fastnear.com and the
# intents.<you>.testnet copy from `make testnet`, which has no default).
VITE_NETWORK=mainnet
VITE_RPC_URL=https://free.rpc.fastnear.com
VITE_VAULT_ID=vault.<owner>.near
VITE_INTENTS_ID=intents.near
VITE_AGENT_URL=http://localhost:8788
# 1 shows the demo strip (scripted attacks).
VITE_DEMO=0
